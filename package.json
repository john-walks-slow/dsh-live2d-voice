{
	"name": "dsh-live2d-voice",
	"version": "1.0.0",
	"description": "Live2D session view with realtime voice: continuous voice input, subtitle translation, multi-model catalog, per-workspace overrides",
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"lib/types",
		"assets/cubism4/live2dcubismcore.min.js",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"live2d",
		"tts",
		"voice"
	],
	"license": "MIT",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-conversation"
			],
			"platform": "web"
		}
	},
	"dependencies": {
		"@deepseek-ai/dsh-llm": "0.1.5-rc.3",
		"ws": "^8.21.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "^4.0.2",
		"@deepseek-ai/dsh-agent": "0.1.5-rc.3",
		"@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
		"@deepseek-ai/dsh-host-webserver": "0.1.5-rc.3",
		"@deepseek-ai/dsh-session": "0.1.5-rc.3",
		"@types/node": "^22.20.1",
		"@types/react": "~18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/ws": "^8.18.1",
		"esbuild": "^0.28.2",
		"pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
		"pixi.js": "^7.4.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.9.3"
	}
}
